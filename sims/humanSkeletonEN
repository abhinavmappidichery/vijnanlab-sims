<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Human Skeleton Interactive Simulator</title>
    <style>
        body {
            font-family: 'AnjaliOldLipi', 'Manjari', Arial, sans-serif;            
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }
        h1 {
            color: #1e3c72;
            margin-bottom: 5px;
            text-align: center;
            font-size: 28px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }
        .instruction {
            color: #4a5568;
            margin-bottom: 25px;
            text-align: center;
            font-size: 16px;
        }
        .main-container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            max-width: 950px;
            width: 100%;
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            align-items: center;
            justify-content: center;
        }
        /* അസ്ഥികൂടത്തിന്റെ ചിത്രം ഉൾക്കൊള്ളുന്ന ഭാഗം */
        .skeleton-layout {
            position: relative;
            width: 300px;
            height: 550px;
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/201805_human_skeleton.png/960px-201805_human_skeleton.png?_=20180716181501');
            background-size: 520px 520px;
            background-repeat: no-repeat;
            background-position: center;
            border-radius: 20px;
            background-color: #ffffff;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.05);
            border: 2px solid #e2e8f0;
        }
        /* നമ്പർ ബട്ടണുകളുടെ ആകര്‍ഷകമായ ശൈലി */
        .node-btn {
            position: absolute;
            width: 25px;
            height: 25px;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            border: 2px solid white;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(255, 65, 108, 0.4);
            transition: all 0.3s ease;
        }
        .node-btn-intro {
            position: absolute;
            width: 90px;
            height: 30px;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            border: 2px solid white;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(255, 65, 108, 0.4);
            transition: all 0.3s ease;
        }
        .node-btn:hover {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            transform: scale(1.3);
            box-shadow: 0 6px 15px rgba(17, 153, 142, 0.5);
        }
        /* ചിത്രത്തിന് മുകളിലെ കൃത്യമായ സ്ഥാനങ്ങൾ */
        #btn-intro  { top: 20px;  left: 10px; } 
        #btn-skull  { top: 35px;  left: 134px; } 
        #btn-neck   { top: 85px;  left: 134px; } 
        #btn-chest  { top: 140px; left: 110px; } 
        #btn-sternum  { top: 140px; left: 136px; } 
        #btn-larm   { top: 155px; left: 87px;  } 
        #btn-spine  { top: 195px; left: 134px; } 
        #btn-hip    { top: 220px; left: 105px; } 
        #btn-legs   { top: 400px; left: 134px; } 
        #btn-sholder { top: 110px; left: 180px; } 
        #btn-hingejoint { top: 200px; left: 195px; } 
        #btn-hingejoint1 { top: 360px; left: 160px; } 
        #btn-cartilage { top: 60px; left: 169px; } 
        #btn-joints { top: 360px; left: 19px; } 

        /* വിവരങ്ങൾ കാണിക്കുന്ന ഇൻഫോ ബോക്സ് */
        .info-box {
            flex: 1;
            min-width: 320px;
            min-height: 320px;
            background: linear-gradient(to bottom right, #ffffff, #f7fafc);
            border: 2px solid #cbd5e0;
            border-radius: 15px;
            padding: 25px;
            box-sizing: border-box;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .info-title {
            font-size: 22px;
            font-weight: bold;
            color: #2b6cb0;
            margin-bottom: 15px;
            border-bottom: 3px solid #63b3ed;
            padding-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .info-section {
            margin-bottom: 14px;
            line-height: 1.7;
            font-size: 15px;
            color: #2d3748;
        }
        .section-title {
            font-weight: bold;
            color: #2c5282;
        }
        .default-text {
            color: #a0aec0;
            text-align: center;
            margin-top: 120px;
            font-style: italic;
            font-size: 16px;
        }
    </style>
</head>
<body>

    <h1>💀 Human Skeleton Interactive Simulator 🦴</h1>
    <p class="instruction">✨Click on each number (1 - 13) in the image to learn about the corresponding body parts!</p>

    <div class="main-container">
        <!-- അസ്ഥികൂടത്തിന്റെ ചിത്രം അടങ്ങിയ ഭാഗം -->
        <div class="skeleton-layout">
            <button id="btn-intro" class="node-btn-intro" onclick="showDetails('intro')">intoduction</button>
            <button id="btn-skull" class="node-btn" onclick="showDetails('skull')">1</button>
            <button id="btn-spine" class="node-btn" onclick="showDetails('spine')">2</button>
            <button id="btn-chest" class="node-btn" onclick="showDetails('chest')">3</button>
            <button id="btn-sternum" class="node-btn" onclick="showDetails('Sternum')">4</button>
            <button id="btn-larm" class="node-btn" onclick="showDetails('larm')">5</button>
            <button id="btn-legs" class="node-btn" onclick="showDetails('legs')">6</button>
            <button id="btn-cartilage" class="node-btn" onclick="showDetails('cartilage')">7</button>
            <button id="btn-joints" class="node-btn" onclick="showDetails('joints_intro')">8</button>
            <button id="btn-hingejoint" class="node-btn" onclick="showDetails('hingejoint')">9</button>
            <button id="btn-hingejoint1" class="node-btn" onclick="showDetails('hingejoint1')">10</button>
            <button id="btn-hip" class="node-btn" onclick="showDetails('hip')">11</button>
            <button id="btn-sholder" class="node-btn" onclick="showDetails('sholder')">12</button>
            <button id="btn-neck" class="node-btn" onclick="showDetails('neck')">13</button>
        </div>

        <div class="info-box" id="info-box">
            <div class="default-text" id="default-text">Click on any number in the image to view the information as a pop-up</div>
            <div id="content-area" style="display: none;">
                <div class="info-title" id="info-title"></div>
                <div class="info-section" id="box-one"><span class="section-title">🦴</span> <span id="info-one"></span></div>
                <div class="info-section" id="box-two"><span class="section-title">🔗</span> <span id="info-two"></span></div>
                <div class="info-section" id="box-three"><span class="section-title">💥</span> <span id="info-three"></span></div>
                <div class="info-section" id="box-four" style="display: none;"><span class="section-title">💡</span> <span id="info-four"></span></div>
                <div class="info-section" id="box-five" style="display: none;"><span class="section-title">💡</span> <span id="info-five"></span></div>
            </div>
        </div>
    </div>

    <script>
        const data = {
    intro: {
        title: "The Human Skeleton - A Description",
        one: "<b>Number of bones: </b>At birth, our body has about 300 bones. As we reach adulthood, many of these bones fuse together and the number reduces to 206."
    },
    skull: {
        title: "1. Skull",
        one: "<b>Number of bones: </b>The skull is made up of 22 bones.",
        two: "<b>Protection: </b>It provides protection to the brain, as well as sensory organs such as the eyes, ears, nose, and tongue.",
        three: "<b>Movable bone: </b>Among the bones in the skull, there is only one movable bone, which is the lower jaw bone. This bone moves while chewing food.",
        four: "<b>Importance of Helmets: </b>Severe impacts or injuries to the head can cause complicated fractures, which are extremely serious as the broken bone can injure the internal brain."
    },
    spine: {
        title: "2. Vertebral Column(നട്ടെല്ല്)",
        one: "<b>Function: </b>The vertebral column is a series of bones that help the body stand straight and move.",
        two: "<b>Vertebrae(കശേരുക്കൾ): </b>The small bones in the vertebral column are called vertebrae.",
        three: "<b>Number of bones: </b>The vertebral column consists of 33 vertebrae arranged in an orderly manner.",
        four: "<b>Protection of Spinal Cord: </b>The spinal cord, an important part of the nervous system, passes through the vertebral column. Hence, it acts as a protective shield of spinal cord.",
        five: "<b>Importance: </b>If the vertebral column is severely damaged, it will be difficult to stand or walk."
    },
    chest: {
        title: "3. Ribs",
        one: "<b>Location and Number: </b>Ribs are located in the chest region of the human body. There are 12 pairs of ribs.",
        two: "<b>Connection: </b>The ribs are connected to the vertebral column at the back and to the sternum in front.",
        three: "<b>Protection: </b>The ribs enfold and protect the heart, lungs, and some major blood vessels.",
        four: "<b>Rib Fracture: </b>Occurs due to strong impacts to the chest. A complicated fracture near internal organs is dangerous as the broken bone causes injury to the lungs or heart."
    },
    Sternum: {
        title: "4. Sternum",
        one: "It is a bone located in the front of the chest region. The ribs are connected to the vertebral column at the back and attach to the sternum in the front to enclose and protect vital internal organs like the heart and lungs."
    },
    larm: {
        title: "5. Hand (Left Arm)",
        one: "<b>Number of bones: </b>Each human arm has 32 bones.",
        two: "<b>Total count: </b>Therefore, there are a total of 64 bones in both arms.",
        three: "<b>Mobility: </b>Arms have more mobility than the legs of the human body.",
        four: "<b>Joints: </b>A hinge joint is found in the elbow(കൈ മുട്ട്) and a ball and socket joint is found in the shoulder. These joints help the arms move in various directions."
    },
    legs: {
        title: "6. Leg Bones",
        one: "<b>Number of bones: </b>Each human leg has 31 bones (making a total of 62 bones in both legs).",
        two: "<b>Strength: </b>Since humans have the ability to stand on two legs, the bones in the legs are stronger than those in the arms.",
        three: "<b>Longest Bone: </b>The femur, which is the longest bone in the human body, is found in the leg.",
        four: "<b>Joints: </b>The hinge joint (in the knee) and the ball and socket joint (in the hip) are associated with the legs to help them move."
    },
    cartilage: {
        title: "7. Cartilages",
        one: "<b>Peculiarity: </b>Cartilages are flexible parts which provide support and strength to the body like bones. They are softer than bones.",
        two: "<b>Locations: </b>Primarily, cartilages are found in the ears, nose, elbows(കൈമുട്ട്), knees(കാൽമുട്ട്), ankles(കണങ്കാൽ), trachea(ശ്വാസനാളം) and the discs between the vertebrae.",
        three: "<b>Function: </b>They allow parts like the ears and nose to be easily bent."
    },
    joints_intro: {
        title: "8. Joints",
        one: "<b>Definition: </b>A joint is the part where two or more bones meet.",
        two: "<b>Various Types of Joints: </b>There are different types of joints in our body. Some joints are movable and some immovable."
    },
    hingejoint: {
        title: "9. Hinge Joint",
        one: "<b>Peculiarity: </b>Like the hinges in a door or window, this joint allows the bones to be moved in only one direction.",
        two: "<b>Locations: </b>The joints found in the elbow and knee are hinge joints."
    },
    hingejoint1: {
        title: "10. Hinge Joint",
        one: "<b>Peculiarity: </b>Like the hinges in a door or window, this joint allows the bones to be moved in only one direction.",
        two: "<b>Locations: </b>The joints found in the elbow and knee are hinge joints."
    },
    hip: {
        title: "11. Ball and Socket Joint (Hip Bone)",
        one: "<b>Function: </b>It connects the upper part of the body with the lower part and provides support.",
        two: "<b>Peculiarity: </b>It is arranged in such a way that the round end of one bone rotates in the cavity of another bone.",
        three: "<b>Joint: </b>A ball and socket joint is found in the hip. This gives the legs maximum freedom of movement.",
        four: "<b>Problems: </b>In older adults, a decrease in the density of minerals like calcium (osteoporosis) makes the bones brittle, leading to sudden fractures here."
    },
    sholder: {
        title: "12. Ball and Socket Joint (Shoulder Bone)",
        one: "<b>Function: </b>It helps the arms to move in various directions.",
        two: "<b>Peculiarity: </b>It is arranged in such a way that the round end of one bone rotates in the cavity of another bone.",
        three: "<b>Joint: </b>The shoulder features a ball and socket joint. It provides maximum freedom of movement in all directions."
    },
    neck: {
        title: "13. Pivot Joint (Neck)",
        one: "This is the region where the topmost vertebrae of the vertebral column connect with the skull.",
        two: "<b>Peculiarity: </b>It is a joint arranged in such a way that one bone moves forward, backward, and side-to-side in another bone.",
        three: "<b>Location: </b>The pivot joint is found in the neck. This allows the neck to be turned forward, backward, left, and right."
    }
        };

        function showDetails(key) {
            document.getElementById('default-text').style.display = 'none';
            document.getElementById('content-area').style.display = 'block';
            
            const item = data[key];
            document.getElementById('info-title').innerText = item.title;

            // One
            const boxOne = document.getElementById('box-one');
            if (item.one) {
                document.getElementById('info-one').innerHTML = item.one;
                boxOne.style.display = 'block';
            } else {
                boxOne.style.display = 'none';
            }

            // Two
            const boxTwo = document.getElementById('box-two');
            if (item.two) {
                document.getElementById('info-two').innerHTML = item.two;
                boxTwo.style.display = 'block';
            } else {
                boxTwo.style.display = 'none';
            }

            // Three (if-else condition added)
            const boxThree = document.getElementById('box-three');
            if (item.three) {
                document.getElementById('info-three').innerHTML = item.three;
                boxThree.style.display = 'block';
            } else {
                boxThree.style.display = 'none';
            }

            // Four
            const boxFour = document.getElementById('box-four');
            if (item.four) {
                document.getElementById('info-four').innerHTML = item.four;
                boxFour.style.display = 'block';
            } else {
                boxFour.style.display = 'none';
            }

            // Five
            const boxFive = document.getElementById('box-five');
            if (item.five) {
                document.getElementById('info-five').innerHTML = item.five;
                boxFive.style.display = 'block';
            } else {
                boxFive.style.display = 'none';
            }
        }
    </script>
</body>
</html>
