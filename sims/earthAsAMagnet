<!DOCTYPE html>
<html lang="en">
<head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Earth as a Magnet</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
body{font-family:'Inter',sans-serif;background-color:#0f172a;overflow:hidden;margin:0;padding:0;color:white}
#app-container{display:flex;flex-direction:column;height:100vh;width:100vw}
#canvas-container{flex:1;position:relative;overflow:hidden;background:radial-gradient(circle at center,#1e293b 0%,#020617 100%)}
canvas{display:block;width:100%;height:100%}
#controls-panel{background:#1e293b;border-top:1px solid #334155;padding:0.5rem 1rem;display:flex;flex-direction:column;gap:0.5rem;z-index:10}
.controls-row{display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;align-items:center}
.btn-action{padding:0.4rem 1rem;border-radius:999px;border:none;font-weight:700;font-size:0.8rem;cursor:pointer;transition:all 0.2s;text-align:center;min-width:140px}
.btn-spin{background:#3b82f6;color:white;border:2px solid #60a5fa}
.btn-toggle{background:#f59e0b;color:#0f172a;border:2px solid #fbbf24}
.btn-toggle.active{background:#10b981;color:white;border-color:#34d399}
#status-overlay{position:absolute;top:8px;left:50%;transform:translateX(-50%);background:rgba(30,41,59,0.92);padding:0.4rem 0.8rem;border-radius:0.5rem;text-align:center;border:1px solid #475569;pointer-events:none;width:max-content;max-width:92%}
</style>
</head>
<body>
<div id="app-container">
<div id="canvas-container">
<canvas id="simCanvas"></canvas>
<div id="status-overlay">
<div id="explanation-title" class="text-xs font-bold text-white">ഭൂമി ഒരു കാന്തം (Earth is a Magnet)</div>
<div id="explanation-desc" class="text-[10px] text-slate-300">സ്വതന്ത്രമായി തൂക്കിയിട്ട കാന്തം</div>
</div>
</div>
<div id="controls-panel">
<div class="controls-row">
<button class="btn-action btn-spin" id="btn-spin">കാന്തം കറക്കുക <span class="text-[9px] font-normal">(Spin)</span></button>
<button class="btn-action btn-toggle" id="btn-toggle-earth">ഉള്ളിലെ കാന്തം കാണുക 🌍</button>
</div>
</div>
</div>
<script>
const canvas=document.getElementById('simCanvas');const ctx=canvas.getContext('2d');
const container=document.getElementById('canvas-container');const titleEl=document.getElementById('explanation-title');const descEl=document.getElementById('explanation-desc');
let width,height,currentAngle=-Math.PI/2,angularVelocity=0,targetAngle=-Math.PI/2;
let showInternalMagnet=false,isSettled=true;
const COLOR_N='#ef4444',COLOR_S='#3b82f6',EARTH_WATER='#0ea5e9',EARTH_LAND='#22c55e';
function resize(){width=container.clientWidth;height=container.clientHeight;canvas.width=width;canvas.height=height;}
window.addEventListener('resize',resize);resize();
document.getElementById('btn-spin').addEventListener('click',()=>{angularVelocity+=(Math.random()>0.5?1:-1)*(Math.random()*0.4+0.4);isSettled=false;updateStatusText();});
const btnToggleEarth=document.getElementById('btn-toggle-earth');
btnToggleEarth.addEventListener('click',()=>{showInternalMagnet=!showInternalMagnet;btnToggleEarth.classList.toggle('active',showInternalMagnet);btnToggleEarth.innerHTML=showInternalMagnet?'ഉള്ളിലെ കാന്തം മറയ്ക്കുക 🌍':'ഉള്ളിലെ കാന്തം കാണുക 🌍';updateStatusText();});
function updateStatusText(){
if(!isSettled){titleEl.textContent="കാന്തം കറങ്ങുന്നു...";titleEl.style.color="#fbbf24";descEl.textContent="കാന്തിക ബലം കാരണം തിരികെ തെക്ക്-വടക്ക് ദിശയിലേക്ക് വരും.";}
else{if(showInternalMagnet){titleEl.textContent="ഭൂമിക്കുള്ളിലെ രഹസ്യം!";titleEl.style.color="#10b981";descEl.textContent="Geographic North-ൽ ഉള്ളത് Magnetic South ആണ്!";}
else{titleEl.textContent="കാന്തം വടക്കോട്ട് തിരിഞ്ഞു നിൽക്കുന്നു";titleEl.style.color="#38bdf8";descEl.textContent="കാന്തം എപ്പോഴും തെക്ക്-വടക്ക് (N-S) ദിശയിൽ നിശ്ചലമാകുന്നു.";}}
}
function drawGlobe(cx,cy,radius){
ctx.save();ctx.translate(cx,cy);
ctx.beginPath();ctx.arc(0,0,radius,0,Math.PI*2);ctx.fillStyle=EARTH_WATER;ctx.fill();
ctx.fillStyle=EARTH_LAND;ctx.beginPath();ctx.ellipse(-radius*0.3,-radius*0.3,radius*0.6,radius*0.4,0.5,0,Math.PI*2);ctx.fill();
ctx.beginPath();ctx.ellipse(radius*0.4,radius*0.1,radius*0.5,radius*0.7,-0.3,0,Math.PI*2);ctx.fill();
ctx.fillStyle='rgba(255,255,255,0.9)';ctx.font='bold 10px Inter';ctx.textAlign='center';
ctx.fillText("Geographic North (ഉത്തര ധ്രുവം)",0,-radius-8);ctx.fillText("Geographic South (ദക്ഷിണ ധ്രുവം)",0,radius+12);
ctx.restore();
}
function drawInternalMagnet(cx,cy,radius,alpha){
if(alpha<=0)return;const magW=radius*0.4,magH=radius*1.3;
ctx.save();ctx.translate(cx,cy);ctx.globalAlpha=alpha;
ctx.fillStyle=COLOR_S;ctx.fillRect(-magW/2,-magH/2,magW,magH/2);
ctx.fillStyle=COLOR_N;ctx.fillRect(-magW/2,0,magW,magH/2);
ctx.strokeStyle='white';ctx.lineWidth=1.5;ctx.strokeRect(-magW/2,-magH/2,magW,magH);
ctx.fillStyle='white';ctx.font='bold 16px Inter';ctx.textAlign='center';ctx.textBaseline='middle';
ctx.fillText("S",0,-magH/4);ctx.fillText("N",0,magH/4);ctx.restore();
}
function drawCompassMagnet(cx,cy,angle){
const magW=90,magH=20;ctx.save();ctx.translate(cx,cy);ctx.rotate(angle);
ctx.fillStyle=COLOR_N;ctx.beginPath();ctx.moveTo(0,-magH/2);ctx.lineTo(magW/2-10,-magH/2);ctx.lineTo(magW/2,0);ctx.lineTo(magW/2-10,magH/2);ctx.lineTo(0,magH/2);ctx.fill();
ctx.fillStyle=COLOR_S;ctx.beginPath();ctx.moveTo(0,-magH/2);ctx.lineTo(-magW/2+10,-magH/2);ctx.lineTo(-magW/2,0);ctx.lineTo(-magW/2+10,magH/2);ctx.lineTo(0,magH/2);ctx.fill();
ctx.strokeStyle='#1e293b';ctx.lineWidth=1;ctx.stroke();
ctx.fillStyle='white';ctx.font='bold 11px Inter';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText("N",magW/4,0);ctx.fillText("S",-magW/4,0);ctx.restore();
}
let internalAlpha=0;
function animate(){
ctx.clearRect(0,0,width,height);const cx=width/2,cy=height/2+5,earthRadius=Math.min(width,height)*0.32;
let diff=targetAngle-currentAngle;while(diff<=-Math.PI)diff+=2*Math.PI;while(diff>Math.PI)diff-=2*Math.PI;
angularVelocity+=0.02*Math.sin(diff);angularVelocity*=0.95;currentAngle+=angularVelocity;
if(Math.abs(angularVelocity)<0.001 && Math.abs(diff)<0.01 && !isSettled){isSettled=true;updateStatusText();}
internalAlpha+=((showInternalMagnet?1:0)-internalAlpha)*0.1;
drawGlobe(cx,cy,earthRadius);drawInternalMagnet(cx,cy,earthRadius,internalAlpha);
drawCompassMagnet(cx,cy,currentAngle);requestAnimationFrame(animate);
}
updateStatusText();animate();
</script>
