<!DOCTYPE html>
<html lang="en">
<head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Demagnetization - Hammer Fixed + Common Color</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#f8fafc}
header{height:44px;background:#fff;border-bottom:2px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;padding:0 12px}
header h1{font-size:13px;font-weight:800;display:flex;align-items:center;gap:8px}
header h1 span{background:#0f172a;color:#fff;width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center}
header .sub{font-size:10px;color:#64748b}
#main{display:flex;height:calc(100vh - 44px);height:calc(100dvh - 44px)}
#left{width:300px;min-width:280px;background:#fff;border-right:2px solid #e2e8f0;display:flex;flex-direction:column;overflow:hidden;flex-shrink:0}
.scroll{flex:1;overflow-y:auto;padding:10px}
.label{font-size:9px;font-weight:800;color:#64748b;letter-spacing:1px;text-transform:uppercase;margin:10px 0 6px}
.btn{width:100%;padding:11px;border:2px solid #e2e8f0;border-radius:12px;background:#fff;cursor:pointer;margin-bottom:8px;display:flex;gap:10px;align-items:center;text-align:left;transition:.15s}
.btn:hover{border-color:#93c5fd;background:#f0f9ff}
.btn.active{border-color:#0f172a;background:#f8fafc;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.icon{width:42px;height:42px;border-radius:10px;background:#f8fafc;border:2px solid #f1f5f9;display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0}
.t{font-size:12px;font-weight:700;color:#0f172a}
.d{font-size:10px;color:#64748b}
.loss{font-size:9px;background:#fef2f2;color:#dc2626;padding:2px 6px;border-radius:20px;font-weight:700;margin-top:3px;display:inline-block}
.meterCard{border:2px solid #e2e8f0;border-radius:12px;padding:11px;margin-top:6px;background:#fff}
.pct{font-size:18px;font-weight:900}
.meter{height:12px;background:#f1f5f9;border-radius:20px;overflow:hidden;margin-top:6px}
.fill{height:100%;background:linear-gradient(90deg,#22c55e,#eab308,#ef4444);width:100%;transition:width .5s}
.status{margin-top:8px;padding:9px 10px;background:#f0f9ff;border-left:3px solid #0ea5e9;border-radius:8px;font-size:11px;color:#0c4a6e;min-height:40px;display:flex;align-items:center}
.reset{width:100%;margin-top:8px;padding:10px;border-radius:10px;border:0;background:#0f172a;color:#fff;font-weight:700;font-size:12px;cursor:pointer}
.tip{margin-top:8px;padding:8px 10px;background:#fffbeb;border-left:3px solid #f59e0b;border-radius:8px;font-size:14px;color:#78350f;line-height:1.4}
#canvasWrap{flex:1;position:relative;background:#fff;display:flex;flex-direction:column;min-width:0;overflow:hidden}
#topBar{height:36px;background:#f8fafc;border-bottom:2px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-size:11px;font-weight:700;flex-shrink:0}
#canvasBox{flex:1;position:relative;overflow:hidden;min-height:200px}
canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none}
@media(max-width:700px){
 html,body{overflow:auto;height:auto}
 #main{flex-direction:column;height:auto}
 #left{width:100%;min-width:100%;max-height:48vh}
 #canvasWrap{height:72vh;min-height:500px}
}
</style>
</head>
<body>
<div id="main">
<div id="left"><div class="scroll">
<div class="label">Choose Action</div>
<div id="list"></div>
<div class="meterCard">
<div style="display:flex;justify-content:space-between"><span style="font-size:9px;font-weight:800;color:#64748b;letter-spacing:1px">STRENGTH</span><span class="pct" id="pct">100%</span></div>
<div class="meter"><div class="fill" id="fill"></div></div>
</div>
<button class="reset" onclick="resetLab()">RESET EXPERIMENT</button>
<div class="tip"><b>Note : </b><span style="font-size: 12px; color: #1B365D; font-weight: 500;">Field lines represent a 3D field in 2D and never intersect <span style="font-size: 10px; color: #4A5568; font-weight: 500;"> (ഫീൽഡ് ലൈനുകൾ യഥാർത്ഥത്തിൽ കൂട്ടിമുട്ടാറില്ല; 3D ഫീൽഡ് 2D-യിൽ കാണിക്കുന്നതിനാലാണിത്)</div>
</div></div>
<div id="canvasWrap">
<div id="topBar"><span id="cStatus">Domains: <b id="domText">18/18 aligned</b></span><span>Field: <b id="fieldText">Strong</b></span></div>
<div id="canvasBox"><canvas id="c"></canvas></div>
</div>
</div>
<script>
const canvas=document.getElementById('c'), ctx=canvas.getContext('2d'), box=document.getElementById('canvasBox');
let W=0,H=0, ox=0, oy=0;
let strength=100;
let domains=[];
let anim=null;
let throwPath=[];
let heatGlow=0, shake=0;

function initDomains(){
 domains=[];
 for(let y=0;y<3;y++) for(let x=0;x<6;x++) domains.push({x,y,ang:0,rand:0});
}
initDomains();

function resize(){
 const rect=box.getBoundingClientRect();
 W=canvas.width=rect.width;
 H=canvas.height=rect.height;
 if(W<10||H<10){ setTimeout(resize,80); return; }
 ox=W*0.5;
 oy=H*0.36; // above red line
}
new ResizeObserver(resize).observe(box);
setTimeout(resize,100);
window.addEventListener('orientationchange',()=>setTimeout(resize,300));

const actions=[
 {id:'heat', icon:'🔥', t:'Heat Magnet', d:'Bunsen burner heats', loss:16},
 {id:'hammer', icon:'🔨', t:'Hammer Hit', d:'Realistic top hit', loss:12},
 {id:'drop', icon:'💫', t:'Drop / Throw', d:'Tumble & impact', loss:10},
 {id:'near', icon:'🧲', t:'Opposite Magnet', d:'N-N repulsion', loss:14},
];

function build(){
 const list=document.getElementById('list');
 list.innerHTML='';
 actions.forEach(a=>{
  const b=document.createElement('button');
  b.className='btn'; b.id='btn-'+a.id;
  b.innerHTML=`<div class="icon">${a.icon}</div><div><div class="t">${a.t}</div><div class="d">${a.d}</div><div class="loss">-${a.loss}%</div></div>`;
  b.onclick=()=>doAction(a.id);
  list.appendChild(b);
 });
}
function doAction(type){
 if(strength<=0){ document.getElementById('status').textContent='Fully demagnetized! Reset.'; return; }
 if(anim){ document.getElementById('status').textContent='Wait...'; return; }
 document.querySelectorAll('.btn').forEach(b=>b.classList.remove('active'));
 const el=document.getElementById('btn-'+type); if(el) el.classList.add('active');
 if(type==='drop'){
  throwPath=[];
  for(let i=0;i<5;i++) throwPath.push({x:0.2+Math.random()*0.6, y:0.12+Math.random()*0.4, r:Math.random()*6.28});
 }
 // Hammer faster: 1600ms instead of 2200, but with pause for kids
 const dur = type==='hammer' ? 1600 : 2000;
 anim={type,start:performance.now(),dur};
 const loss={heat:16,hammer:12,drop:10,near:14};
 strength=Math.max(0,strength-loss[type]);
 // half-half flip
 let aligned = domains.filter(d=>d.rand<0.5);
 let toFlip = Math.ceil(aligned.length*0.5);
 let candidates = aligned.sort(()=>Math.random()-0.5).slice(0,toFlip);
 candidates.forEach(d=>{ d.rand=0.7+Math.random()*0.3; d.ang=Math.random()*6.28; });
 domains.forEach(d=>{ if(d.rand>=0.5) d.ang+=(Math.random()-0.5)*1.2; });
 updateUI();
 if(type==='hammer') shake=14;
 if(type==='heat') heatGlow=1;
}
function resetLab(){
 strength=100; anim=null; shake=0; heatGlow=0; initDomains();
 document.querySelectorAll('.btn').forEach(b=>b.classList.remove('active'));
 document.getElementById('status').textContent='Reset! All domains aligned. Hammer fixed - hits from top.';
 updateUI();
}
function updateUI(){
 document.getElementById('pct').textContent=Math.round(strength)+'%';
 document.getElementById('fill').style.width=strength+'%';
 const aligned=domains.filter(d=>d.rand<0.5).length;
 const total=domains.length;
 document.getElementById('domText').innerHTML=`${aligned}/${total} aligned`;
 document.getElementById('fieldText').textContent=strength>70?'Strong':strength>35?'Medium':strength>10?'Weak':'Very Weak';
}

function getThrow(t){
 if(!throwPath.length) return {x:ox,y:oy,r:0};
 const scaled=t*(throwPath.length-1);
 const i=Math.min(throwPath.length-2, Math.floor(scaled));
 const f=scaled-i;
 const a=throwPath[i], b=throwPath[i+1];
 return {x:(a.x+(b.x-a.x)*f)*W, y:(a.y+(b.y-a.y)*f)*H, r:a.r+(b.r-a.r)*f};
}

function draw(){
 if(W<10){ requestAnimationFrame(draw); return; }
 ctx.clearRect(0,0,W,H);
 ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,W,H);
 const tableY=H*0.78;
 ctx.fillStyle='#f8fafc'; ctx.fillRect(0,tableY,W,16);
 ctx.strokeStyle='#e2e8f0'; ctx.lineWidth=1; ctx.strokeRect(0,tableY,W,16);

 let mx=ox, my=oy, rot=0, active=false, prog=0;
 if(anim){
  const elapsed=performance.now()-anim.start;
  prog=Math.min(1,elapsed/anim.dur);
  active=prog<1;
  if(anim.type==='drop'){
   const p=getThrow(prog);
   mx=p.x; my=p.y; rot=p.r;
  }
  if(prog>=1){
   anim=null; shake=0; heatGlow=0;
   document.querySelectorAll('.btn').forEach(b=>b.classList.remove('active'));
  }
 }

// field lines with moving black arrows (N to S & Outer Loops)
  const count = Math.max(0, Math.ceil(strength / 15));
  const tTime = (Date.now() * 0.0018) % 1;
  
  for (let i = 1; i <= count; i++) {
    // ലൈനുകൾ തമ്മിലുള്ള അകലം (Spread & Outer reach) കൂട്ടി
    const spread = 28 + i * 22; 
    const outerX = 100 + i * 20;

    // 1. ഫീൽഡ് ലൈനുകൾ വരയ്ക്കുന്നു
    ctx.save();
    ctx.strokeStyle = `rgba(15, 23, 42, ${0.16 + strength / 240})`;
    ctx.lineWidth = 1.4;
    ctx.setLineDash([]);

    // മുകളിലെ ലൈൻ
    ctx.beginPath();
    ctx.moveTo(mx - 90, my);
    ctx.bezierCurveTo(mx - outerX, my - spread, mx + outerX, my - spread, mx + 90, my);
    ctx.stroke();

    // താഴത്തെ ലൈൻ
    ctx.beginPath();
    ctx.moveTo(mx - 90, my);
    ctx.bezierCurveTo(mx - outerX, my + spread, mx + outerX, my + spread, mx + 90, my);
    ctx.stroke();
    ctx.restore();

    // 2. N-ൽ നിന്ന് S-ലേക്ക് കൃത്യമായി നീങ്ങുന്ന അമ്പടയാളങ്ങൾ
    [-1, 1].forEach(dir => {
      const sp = dir * spread;
      const p0 = { x: mx - 90, y: my };
      const p1 = { x: mx - outerX, y: my + sp };
      const p2 = { x: mx + outerX, y: my + sp };
      const p3 = { x: mx + 90, y: my };

      const t = (tTime + (i * 0.22)) % 1;

      // Bezier curve points
      const ax = Math.pow(1 - t, 3) * p0.x + 3 * Math.pow(1 - t, 2) * t * p1.x + 3 * (1 - t) * Math.pow(t, 2) * p2.x + Math.pow(t, 3) * p3.x;
      const ay = Math.pow(1 - t, 3) * p0.y + 3 * Math.pow(1 - t, 2) * t * p1.y + 3 * (1 - t) * Math.pow(t, 2) * p2.y + Math.pow(t, 3) * p3.y;

      // Tangent Angle
      const dx = 3 * Math.pow(1 - t, 5) * (p1.x - p0.x) + 6 * (1 - t) * t * (p2.x - p1.x) + 3 * Math.pow(t, 2) * (p3.x - p2.x);
      const dy = 3 * Math.pow(1 - t, 2) * (p1.y - p0.y) + 6 * (1 - t) * t * (p2.y - p1.y) + 3 * Math.pow(t, 2) * (p3.y - p2.y);
      const ang = Math.atan2(dy, dx);

      ctx.save();
      ctx.translate(ax, ay);
      ctx.rotate(ang);
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.moveTo(5, 0);
      ctx.lineTo(-4, -3.5);
      ctx.lineTo(-4, 3.5);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    });
  }
  
 // MAGNET - BIGGER, ATTRACTIVE, WITH RED GLOW ON HEAT
 ctx.save();
 ctx.translate(mx,my); ctx.rotate(rot);
 if(shake>0) ctx.translate((Math.random()-0.5)*shake,(Math.random()-0.5)*shake*0.5);
 ctx.fillStyle='rgba(0,0,0,0.13)'; ctx.beginPath(); ctx.ellipse(0,56,78,9,0,0,Math.PI*2); ctx.fill();
 const magW=W<500?152:192, magH=W<500?44:56;
 // N red, S blue - attractive vibrant
 let nCol='#ef4444', sCol='#3b82f6';
 if(heatGlow>0){
  const pulse=Math.sin(Date.now()*0.018)*0.25+0.75;
  ctx.shadowColor='#ef4444'; ctx.shadowBlur=24*pulse*heatGlow;
  // when hot, magnet turns reddish-orange
  nCol=`rgba(239,68,68,${0.95})`;
  sCol=`rgba(248,113,113,${0.9})`;
 }
 ctx.fillStyle=nCol; ctx.fillRect(-magW/2,-magH/2,magW/2,magH);
 ctx.fillStyle=sCol; ctx.fillRect(0,-magH/2,magW/2,magH);
 ctx.shadowBlur=0; ctx.shadowColor='transparent';
 if(heatGlow>0){
  // bright red overlay when heating - clearly visible
  ctx.fillStyle=`rgba(252,165,165,${heatGlow*0.55})`;
  ctx.fillRect(-magW/2,-magH/2,magW,magH);
  ctx.strokeStyle=`rgba(220,38,38,${heatGlow})`; ctx.lineWidth=3.5; ctx.strokeRect(-magW/2,-magH/2,magW,magH);
 }
 ctx.fillStyle='rgba(255,255,255,0.28)'; ctx.fillRect(-magW/2,-magH/2,magW,magH*0.38);
 ctx.strokeStyle='#1e293b'; ctx.lineWidth=2.2; ctx.strokeRect(-magW/2,-magH/2,magW,magH);
 ctx.beginPath(); ctx.moveTo(0,-magH/2); ctx.lineTo(0,magH/2); ctx.stroke();
 ctx.fillStyle='#fff'; ctx.font=`900 ${magH*0.52}px sans-serif`; ctx.textAlign='center'; ctx.textBaseline='middle';
 ctx.fillText('N',-magW/4,1); ctx.fillText('S',magW/4,1);
 ctx.strokeStyle='rgba(0,0,0,0.25)'; ctx.lineWidth=0.6; ctx.strokeText('N',-magW/4,1); ctx.strokeText('S',magW/4,1);
 
 // DOMAINS - COMMON COLOR VISIBLE ON BOTH RED & BLUE
 // Problem: red domains on red background invisible, blue on blue invisible
 // Solution: Use bright YELLOW with BLACK OUTLINE - visible on both red and blue!
 // Aligned: bright yellow with black outline, Random: orange-yellow with red outline - both visible on red & blue
 const cellW=(magW*0.84)/6, cellH=(magH*0.64)/3;
 const startX=-magW*0.42, startY=-magH*0.32;
 domains.forEach(d=>{
  const cx=startX+d.x*cellW+cellW/2;
  const cy=startY+d.y*cellH+cellH/2;
  ctx.save(); ctx.translate(cx,cy); ctx.rotate(d.ang);
  const isAligned = d.rand<0.5;
  // COMMON COLOR - visible on both red and blue backgrounds
  // Use bright cyan-yellow with dark outline - not white, not black, but high contrast
  if(isAligned){
   // Aligned: BRIGHT LIME YELLOW with BLACK outline - visible on red AND blue
   ctx.fillStyle='#a3e635'; // lime
   ctx.strokeStyle='#1e293b'; ctx.lineWidth=2;
  }else{
   // Random: BRIGHT ORANGE with BLACK outline - also visible on both
   ctx.fillStyle='#fb923c'; // orange
   ctx.strokeStyle='#7c2d12'; ctx.lineWidth=2;
  }
  // draw arrow with thick outline
  ctx.beginPath(); ctx.moveTo(-cellW*0.30,0); ctx.lineTo(cellW*0.30,0); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cellW*0.30,0); ctx.lineTo(cellW*0.10,-4); ctx.lineTo(cellW*0.10,4); ctx.closePath(); ctx.fill(); ctx.stroke();
  ctx.restore();
 });
 ctx.restore();

 // HAMMER - REALISTIC, FROM TOP, CORRECT POSITION & TIMING
 if(anim && active && anim.type==='hammer'){
  // Hammer should be directly above magnet center, hitting from top
  // Pivot is above magnet, hammer falls down onto magnet top surface
  const pivotX=mx, pivotY=my-110; // pivot 110px above magnet center
  // Faster swing: easeOut cubic, hits at 55% progress, then slight bounce
  let swingProg;
  if(prog<0.55){
   // falling phase - fast ease out
   const t=prog/0.55;
   swingProg=1-Math.pow(1-t,3); // easeOut cubic - fast start, slow end
  }else{
   // after hit - small bounce back
   const t=(prog-0.55)/0.45;
   swingProg=1 - t*0.25*Math.sin(t*Math.PI*4); // slight bounce
  }
  const angle= (Math.PI/2.2)*(1-swingProg); // from 82deg to 0deg
  const hx=pivotX-Math.cos(angle)*105;
  const hy=pivotY-Math.sin(angle)*105;
  
  ctx.save();
  ctx.translate(pivotX,pivotY);
  ctx.rotate(angle);
  // handle - wood with grain
  const woodGrad=ctx.createLinearGradient(-95,0,0,0);
  woodGrad.addColorStop(0,'#78350f'); woodGrad.addColorStop(0.3,'#d6a15c'); woodGrad.addColorStop(0.7,'#fde68a'); woodGrad.addColorStop(1,'#451a03');
  ctx.fillStyle=woodGrad; ctx.fillRect(-95,-9,95,18);
  ctx.strokeStyle='#451a03'; ctx.lineWidth=1.2; ctx.strokeRect(-95,-9,95,18);
  // metal head - realistic with highlight
  const metalGrad=ctx.createLinearGradient(-125,0,-95,0);
  metalGrad.addColorStop(0,'#475569'); metalGrad.addColorStop(0.4,'#e2e8f0'); metalGrad.addColorStop(1,'#1e293b');
  ctx.fillStyle=metalGrad;
  ctx.beginPath();
  ctx.moveTo(-125,-20); ctx.lineTo(-92,-20); ctx.lineTo(-86,-10); ctx.lineTo(-88,12); ctx.lineTo(-125,14); ctx.closePath(); ctx.fill();
  ctx.strokeStyle='#0f172a'; ctx.lineWidth=1.5; ctx.stroke();
  // highlight on metal
  ctx.fillStyle='rgba(255,255,255,0.4)'; ctx.fillRect(-120,-18,20,6);
  ctx.restore();
  
  // pivot bolt - realistic
  ctx.fillStyle='#1e293b'; ctx.beginPath(); ctx.arc(pivotX,pivotY,5.5,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#64748b'; ctx.beginPath(); ctx.arc(pivotX,pivotY,2.5,0,Math.PI*2); ctx.fill();
  
  // impact effect - when hitting
  if(prog>0.50 && prog<0.72){
   // spark burst
   ctx.strokeStyle='#f59e0b'; ctx.lineWidth=2.2;
   for(let i=0;i<7;i++){
    const a=-2.6+i*0.6+Math.random()*0.2;
    const len=18+Math.random()*12;
    ctx.beginPath(); ctx.moveTo(hx,my-magH/2); ctx.lineTo(hx+Math.cos(a)*len, my-magH/2+Math.sin(a)*len); ctx.stroke();
   }
   // impact ring
   ctx.strokeStyle='rgba(239,68,68,0.6)'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(mx,my-magH/2,8+prog*20,0,Math.PI*2); ctx.stroke();
  }
 }
 if(anim && active && anim.type==='heat'){
  const bx=ox, by=H*0.78;
  ctx.fillStyle='#cbd5e1'; ctx.beginPath(); ctx.ellipse(bx,by+10,34,7,0,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#94a3b8'; ctx.fillRect(bx-18,by-12,36,24);
  ctx.fillStyle='#475569'; ctx.fillRect(bx-9,by-34,18,24);
  const flick=Math.sin(Date.now()*0.02)*4;
  const fh=46+prog*60+flick;
  ctx.beginPath();
  ctx.moveTo(bx,by-34-fh);
  ctx.bezierCurveTo(bx-16,by-34-fh*0.5,bx-11,by-34,bx,by-34);
  ctx.bezierCurveTo(bx+11,by-34,bx+16,by-34-fh*0.5,bx,by-34-fh);
  const g=ctx.createLinearGradient(0,by-34-fh,0,by-34);
  g.addColorStop(0,'#fef08a'); g.addColorStop(0.4,'#fb923c'); g.addColorStop(0.7,'#ef4444'); g.addColorStop(1,'#3b82f6');
  ctx.fillStyle=g; ctx.fill();
 }
 if(anim && active && anim.type==='near'){
  const sx=ox+50+prog*35, sy=oy-22;
  ctx.save(); ctx.translate(sx,sy); ctx.rotate(-0.5);
  ctx.fillStyle='#ef4444'; ctx.fillRect(-32,-11,32,22);
  ctx.fillStyle='#3b82f6'; ctx.fillRect(0,-11,32,22);
  ctx.strokeStyle='#1e293b'; ctx.lineWidth=1.2; ctx.strokeRect(-32,-11,64,22);
  ctx.fillStyle='#fff'; ctx.font='800 10px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText('N',-16,0); ctx.fillText('S',16,0);
  ctx.restore();
  ctx.strokeStyle='rgba(139,92,246,0.6)'; ctx.setLineDash([4,4]); ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(ox+12,oy-4,18+prog*12,-1,1); ctx.stroke(); ctx.setLineDash([]);
 }

 requestAnimationFrame(draw);
}

build();
updateUI();
requestAnimationFrame(draw);
